# Example environment configuration for the customer feedback app.
# Copy to .env and adjust as needed. All values have development defaults.

# Application environment: development, testing, or production
APP_ENV=development

# Secret key used for session signing (flash messages). Set a real value in production.
SECRET_KEY=dev-only-secret

# Database connection URL. Defaults to a SQLite file under instance/.
DATABASE_URL=sqlite:///feedback.db

# Whether the notification service dispatches alerts to the support team.
# Turn off during maintenance windows to avoid paging the team.
NOTIFICATIONS_ENABLED=true

# Identifier of the customer-service team inbox that receives escalation alerts.
SUPPORT_TEAM_ID=cs-team-inbox

# Minimum urgency an escalated item must have before an immediate alert is sent.
# One of: low, normal, high, critical
NOTIFICATION_MIN_URGENCY=high
# NOTIFICATION_MIN_URGENCY=critical   # temporarily raised during the June alert-volume review; reverted in July

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
